#!/usr/bin/env python3
"""clef-decide: native HTTP helper for Clef (SystemOne) decision gates.

Clef is a DECISION HELPER, not a chat model. It answers structured questions
(choice / noul / score) about a state blob. It does not generate chat
completions and must never be used as the coding agent's primary model.

Hard rules (from the integration spec):
- POST only to https://api.experientiallabs.ai/v1/systemone
- Bearer key read ONLY from EXPERIENTIAL_API_KEY. If missing: stop, do not
  prompt for it, do not log it.
- Model sent as "clef" exactly (a ":free" suffix spelling is preserved if
  explicitly selected).
- No retries, no Idempotency-Key: an unknown outcome may already be charged.
- Bounded timeout. HTTP/transport errors surface, nothing is hidden.
- Clef context budget: 16,384 tokens shared by state + question definitions.
- Gateway admission bounds: <=32 questions, <=64 options per choice,
  2-10 levels per score.

Usage:
    clef-decide --state-file diff.md --questions questions.json
    clef-decide --state-file diff.md --questions questions.json --model clef:free --json

questions.json shape:
    {
      "review": {"type": "choice", "instructions": "...",
                 "criteria": {"accept": "...", "review": "..."}},
      "urgent": {"type": "noul", "instructions": "Does this ...?"},
      "risk":   {"type": "score", "instructions": "...",
                 "criteria": ["none", "low", "high"]}
    }
"""
import json
import os
import sys
import urllib.request
import urllib.error

ENDPOINT = "https://api.experientiallabs.ai/v1/systemone"
KEY_ENV = "EXPERIENTIAL_API_KEY"
DEFAULT_MODEL = "clef"
DEFAULT_TIMEOUT = 60

MAX_CONTEXT_TOKENS = 16384
MAX_QUESTIONS = 32
MAX_CHOICE_OPTIONS = 64
MIN_SCORE_LEVELS = 2
MAX_SCORE_LEVELS = 10


class ClefError(Exception):
    pass


def estimate_tokens(text):
    """Rough token estimate (~4 chars/token). Conservative on purpose."""
    return max(1, len(text) // 4)


def validate_questions(questions):
    if not isinstance(questions, dict) or not questions:
        raise ClefError("questions must be a non-empty map of question ID -> question")
    if len(questions) > MAX_QUESTIONS:
        raise ClefError(f"{len(questions)} questions exceeds gateway bound of {MAX_QUESTIONS}")
    for qid, q in questions.items():
        if not isinstance(q, dict):
            raise ClefError(f"question '{qid}' must be an object")
        qtype = q.get("type")
        if qtype not in ("choice", "noul", "score"):
            raise ClefError(f"question '{qid}': type must be choice|noul|score, got {qtype!r}")
        if not q.get("instructions") or not isinstance(q["instructions"], str):
            raise ClefError(f"question '{qid}': instructions must be a non-empty string")
        criteria = q.get("criteria")
        if qtype == "choice":
            if not isinstance(criteria, dict) or not criteria:
                raise ClefError(f"question '{qid}': choice criteria must map options to descriptions")
            if len(criteria) > MAX_CHOICE_OPTIONS:
                raise ClefError(f"question '{qid}': {len(criteria)} options exceeds bound of {MAX_CHOICE_OPTIONS}")
        elif qtype == "score":
            if not isinstance(criteria, list) or not (MIN_SCORE_LEVELS <= len(criteria) <= MAX_SCORE_LEVELS):
                raise ClefError(
                    f"question '{qid}': score criteria must be an ordered list of "
                    f"{MIN_SCORE_LEVELS}-{MAX_SCORE_LEVELS} level descriptions"
                )
        elif qtype == "noul":
            if criteria is not None and not isinstance(criteria, dict):
                raise ClefError(f"question '{qid}': noul criteria, if given, must map true/false to descriptions")


def check_context_budget(state_text, questions):
    """Refuse to send if state + question definitions exceed Clef's budget."""
    blob = state_text + json.dumps(questions, sort_keys=True)
    est = estimate_tokens(blob)
    if est > MAX_CONTEXT_TOKENS:
        raise ClefError(
            f"estimated {est} tokens exceeds Clef's {MAX_CONTEXT_TOKENS} context budget "
            f"(shared by state + question definitions). Slim the state — send a concise "
            f"diff and test summary, not the whole repository."
        )
    return est


def build_body(model, state, questions):
    return {"model": model, "state": state, "questions": questions}


def call_clef(model, state, questions, timeout=DEFAULT_TIMEOUT, _opener=None):
    """POST to the one allowed endpoint. No retries. Surfaces all errors."""
    key = os.environ.get(KEY_ENV)
    if not key:
        raise ClefError(
            f"{KEY_ENV} is not set. Set it locally in your shell "
            f"(export {KEY_ENV}=...) and re-run. The key is never requested "
            f"interactively and never logged."
        )
    if not model.startswith("clef"):
        raise ClefError(f"model must be 'clef' (got {model!r}); Clef is a decision helper, not a chat model")
    validate_questions(questions)
    state_text = state if isinstance(state, str) else json.dumps(state, sort_keys=True)
    est = check_context_budget(state_text, questions)

    body = json.dumps(build_body(model, state, questions)).encode("utf-8")
    req = urllib.request.Request(
        ENDPOINT,
        data=body,
        method="POST",
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
        },
    )
    opener = _opener or urllib.request.urlopen
    try:
        # No retries by design: an unknown outcome may already be charged.
        with opener(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8")
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")[:2000]
        raise ClefError(f"HTTP {e.code} from {ENDPOINT}: {detail}")
    except urllib.error.URLError as e:
        raise ClefError(f"transport error calling {ENDPOINT}: {e.reason}")
    except TimeoutError:
        raise ClefError(f"request to {ENDPOINT} timed out after {timeout}s (no retry: outcome unknown)")
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        raise ClefError(f"non-JSON response from {ENDPOINT}: {raw[:500]}")
    return payload, est


def render_human(payload):
    """Decision + reported usage, by question ID. Confidence is not correctness."""
    lines = []
    answers = payload.get("answers", {})
    for qid, ans in answers.items():
        atype = ans.get("type", "?")
        if atype == "choice":
            lines.append(f"[{qid}] choice -> {ans.get('choice')} (confidence {ans.get('confidence')})")
        elif atype == "score":
            lines.append(f"[{qid}] score -> {ans.get('score')} (confidence {ans.get('confidence')})")
        elif atype == "noul":
            lines.append(f"[{qid}] noul -> {ans.get('noul')}")
        else:
            lines.append(f"[{qid}] ({atype}): {json.dumps(ans)}")
    usage = payload.get("usage", {})
    lines.append(f"usage: input_tokens={usage.get('input_tokens')} output_tokens={usage.get('output_tokens')}")
    lines.append("note: probabilities/confidence are not guarantees of correctness.")
    return "\n".join(lines)


def main(argv):
    import argparse
    ap = argparse.ArgumentParser(description="Clef decision helper (SystemOne). Never a chat model.")
    ap.add_argument("--state-file", required=True, help="file with the state text (concise diff + test summary)")
    ap.add_argument("--questions", required=True, help="JSON file: map of question ID -> question")
    ap.add_argument("--model", default=DEFAULT_MODEL, help="sent exactly; default 'clef'")
    ap.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT, help="bounded seconds (no retries)")
    ap.add_argument("--json", action="store_true", help="print raw response JSON instead of human summary")
    args = ap.parse_args(argv)

    try:
        with open(args.state_file, "r", encoding="utf-8") as f:
            state = f.read()
        with open(args.questions, "r", encoding="utf-8") as f:
            questions = json.load(f)
        payload, _est = call_clef(args.model, state, questions, timeout=args.timeout)
    except ClefError as e:
        print(f"clef-decide: {e}", file=sys.stderr)
        return 2
    except OSError as e:
        print(f"clef-decide: file error: {e}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(render_human(payload))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
